# ════════════════════════════════════════════════════════════════
#  .env.example — Copy this file to .env and fill in your values
#  NEVER commit your real .env file to version control
# ════════════════════════════════════════════════════════════════

# ── Shared Server Config ──────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# ── MongoDB (Aetheris D2C) ────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/your_db_name

# ── JWT Auth Secret (Aetheris D2C) ───────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars

# ── LLM API Keys (CareerLens AI) — all optional, app works offline without these
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
